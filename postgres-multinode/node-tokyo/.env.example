# Node Tokyo (n3) - ap-northeast-1
NODE_NAME=n3
NODE_REGION=ap-northeast-1

# Hostnames - set these to your actual Netbird or domain hostnames
NODE_INDIA_HOSTNAME=node-india.netbird.cloud
NODE_US_EAST_HOSTNAME=node-us-east.netbird.cloud
NODE_TOKYO_HOSTNAME=node-tokyo.netbird.cloud

# Database passwords (SAME across all nodes)
APP_PASSWORD=
ADMIN_PASSWORD=
PGEDGE_PASSWORD=
PGCAT_AUTH_PASSWORD=
PGCAT_ADMIN_PASSWORD=

# Traefik (if using public domain mode)
TRAEFIK_DOMAIN=db-tokyo.example.com
ACME_EMAIL=admin@example.com

# Netbird VPN
NETBIRD_SETUP_KEY=
NETBIRD_MANAGEMENT_URL=https://api.netbird.io

# =============================================================================
# PostgreSQL Multi-Active Write Deployment - Environment Configuration
# =============================================================================
# Copy this file to .env in each node directory and customize per node.
#
# IMPORTANT: Use the SAME passwords across ALL nodes.
# Only change NODE_NAME, NODE_REGION, and hostname values per node.
# =============================================================================

# --- Node Identity ---
# Which node this instance represents (n1, n2, or n3)
NODE_NAME=n1
NODE_REGION=ap-south-1

# --- Hostnames for All Nodes ---
# Option A: Netbird VPN hostnames (recommended)
#   Use the Netbird peer hostname or IP assigned to each node.
#   Example: node-india.netbird.cloud, node-us-east.netbird.cloud
#
# Option B: Public domain names (Traefik TLS mode)
#   Use FQDN that resolves to each node's public IP.
#   Example: db-india.example.com, db-us-east.example.com
NODE_INDIA_HOSTNAME=node-india.netbird.cloud
NODE_US_EAST_HOSTNAME=node-us-east.netbird.cloud
NODE_TOKYO_HOSTNAME=node-tokyo.netbird.cloud

# --- Database Passwords (MUST be identical across all nodes) ---
APP_PASSWORD=CHANGE_ME_app_password_here
ADMIN_PASSWORD=CHANGE_ME_admin_password_here
PGEDGE_PASSWORD=CHANGE_ME_pgedge_password_here
PGCAT_AUTH_PASSWORD=CHANGE_ME_pgcat_auth_password_here
PGCAT_ADMIN_PASSWORD=CHANGE_ME_pgcat_admin_password_here

# --- Traefik TLS (Option B only) ---
# Domain for this specific node's Traefik certificate
TRAEFIK_DOMAIN=db-india.example.com
ACME_EMAIL=admin@example.com

# --- Netbird VPN (Option A only) ---
NETBIRD_SETUP_KEY=CHANGE_ME_netbird_setup_key
NETBIRD_MANAGEMENT_URL=https://api.netbird.io
